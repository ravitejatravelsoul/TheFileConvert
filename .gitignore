# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# first-launch QA downloads (large; regenerated by qa/scripts/fl-*.mjs)
/qa/evidence/fresh/out/
/qa/review/fresh-launch/18-scan-edit-user-supplied-*.png
/qa/fresh-scenario-fixtures/*
!/qa/fresh-scenario-fixtures/README.md
!/qa/fresh-scenario-fixtures/fixtures.json
!/qa/fresh-scenario-fixtures/ocr-truth.json
!/qa/fresh-scenario-fixtures/word/
/qa/fresh-scenario-fixtures/word/*
!/qa/fresh-scenario-fixtures/word/README.md
!/qa/fresh-scenario-fixtures/word/truth.json
!/qa/fresh-scenario-fixtures/docx/
/qa/fresh-scenario-fixtures/docx/*
!/qa/fresh-scenario-fixtures/docx/README.md
!/qa/fresh-scenario-fixtures/docx/truth.json
/qa/evidence/fresh/*.log
/qa/review/fresh-launch-polish/pdf-to-word-renders/*.html
/qa/review/fresh-launch-polish/pdf-to-word-renders/REAL*
# fidelity audit: regenerated work files and corpus (qa/scripts/fid-corpus.py + LibreOffice); renders of the
# user's own scan never leave this machine
/qa/fidelity/_work/
/qa/fidelity/corpus/
/qa/fidelity/**/_private/
/.tmp-fid/
__pycache__/
